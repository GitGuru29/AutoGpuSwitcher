[Unit]
Description=Auto GPU Switcher - workload-based Intel/NVIDIA switching
# DEPRECATED: Workload analysis is now built into the Titan daemon
# (titan-gpu-switcherd). This timer is only needed as a fallback when
# running WITHOUT the Titan daemon (e.g., non-Hyprland setups).
# On Archtitn OS (Hyprland-only), disable this and use the daemon.
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/autogpuswitcher/gpu_auto_switcher.py
# The switcher may need root for prime-select/bbswitch fallback paths.
# When the Titan daemon is running, no root is needed (it delegates via IPC).
# Uncomment the next line if NOT using the Titan daemon:
# User=root
Environment=TITAN_SOCKET_PATH=/run/titan-gpu/daemon.sock
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
